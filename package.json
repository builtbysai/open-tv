{
  "name": "open-tv",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts server tests",
    "format": "prettier --write src tests scripts docs *.json *.ts",
    "catalog:sync": "NODE_USE_ENV_PROXY=1 tsx scripts/sync-cinema.ts && npm run updates:prepare",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:keys",
    "check:keys": "tsx scripts/check-keys.ts public dist dist-site",
    "android:debug": "node scripts/build-android.mjs",
    "relay:serve": "node server/relay.ts relay.config.json",
    "extension:check": "tsx scripts/check-extension.ts",
    "extension:split": "tsx scripts/extension-tools.ts split",
    "extension:bundle": "tsx scripts/extension-tools.ts bundle",
    "updates:prepare": "tsx scripts/update-assets.ts",
    "verify:deployment": "NODE_USE_ENV_PROXY=1 tsx scripts/verify-deployment.ts",
    "build:site": "tsc -b && VITE_SITE_BUILD=1 vite build --outDir dist-site"
  },
  "dependencies": {
    "hls.js": "^1.6.13",
    "lucide-react": "^0.468.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
