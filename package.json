{
  "name": "open-tv",
  "version": "1.0.0",
  "description": "TMDB on your TV, playing from your own servers, with your phone as the remote.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src control/src tests e2e scripts",
    "relay:dev": "tsx control/src/node.ts",
    "check:compat": "tsx scripts/check-compat.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:compat",
    "android:debug": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.1.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/qrcode-generator": "^0.0.16",
    "@types/ws": "^8.18.2",
    "es-check": "^9.8.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  }
}
