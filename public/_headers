/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://image.tmdb.org data: http://127.0.0.1:* http://localhost:*; media-src 'none'; connect-src 'self' https: wss: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; frame-src https: http://127.0.0.1:* http://localhost:*; worker-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/bridge/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
/index.html
  Cache-Control: no-cache
