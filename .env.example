# No keys are required. Provider credentials are supplied through the UI, in memory.
# Run npm run catalog:sync to update the reviewed public catalog before building.
# Public contact only, not a secret. Formal notice submission stays unavailable until configured.
VITE_TAKEDOWN_EMAIL=
# A public HTTPS form/issue endpoint you monitor. The private repo fallback requires access.
VITE_PUBLIC_REPORT_URL=
# Use disabled for a general-only build: 18+ content is unavailable and its playlists are
# left out of the published files.
# Public restricted-content deployments need a verified gateway and jurisdiction review.
VITE_PRIVATE_VIEWING=local

# Optional operator-controlled public HTTPS manifest. Default: same-origin web; the site address in site.config.json on TV.
# No credentials, query strings or fragments. Set disabled to omit remote checks.
VITE_CATALOG_UPDATE_URL=
